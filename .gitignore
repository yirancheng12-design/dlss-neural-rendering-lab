# Git Ignore for Research Repository

# OS generated files
.DS_Store
Thumbs.db

# IDE/Editor files
.vscode/
.idea/
*.swp

# Temporary/Backup files
*.tmp
*.bak
*.old

# Log files (if not part of the research)
*.log

# Python inspector artifacts
__pycache__/
*.py[cod]
.venv/

# Local installer reports
/.setup.log
/.setup-state.json
